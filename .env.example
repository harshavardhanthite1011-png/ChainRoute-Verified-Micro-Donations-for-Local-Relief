# ==============================================================================
# ChainRoute - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env and provide your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# MST Blockchain Configuration
# ------------------------------------------------------------------------------
# Testnet: Chain ID 91562037 (https://testnet.mstscan.com)
MST_TESTNET_RPC=https://testnetrpc.mstblockchain.com

# Mainnet: Chain ID 4646 (https://mstscan.com)
MST_MAINNET_RPC=https://mariorpc.mstblockchain.com/

# Deployer / Relayer Private Key (Export from BridgeKey or MetaMask)
# Fund with testnet tokens via https://faucet.mstblockchain.com
PRIVATE_KEY=your_private_key_here_without_quotes

# ------------------------------------------------------------------------------
# Smart Contract Addresses (Populated after running deployment scripts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_ADDRESS_TESTNET=
NEXT_PUBLIC_CONTRACT_ADDRESS_MAINNET=

# ------------------------------------------------------------------------------
# Database & Cloud Storage (Supabase)
# ------------------------------------------------------------------------------
# Used for off-chain bill images, delivery photos, organizer IDs, and vendor lists
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Vision AI Model (Automated Bill OCR & Fraud Extraction)
# ------------------------------------------------------------------------------
# Model reads bills and outputs strict JSON (vendor, GSTIN, invoice no, amount, items)
VISION_AI_API_KEY=your_ai_api_key_here
VISION_AI_PROVIDER=gemini # or openai

# ------------------------------------------------------------------------------
# Payment Gateway (Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
